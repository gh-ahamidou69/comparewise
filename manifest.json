{
  "manifest_version": 3,
  "name": "CompareWise",
  "version": "0.1.0",
  "description": "Comparez les produits de plusieurs onglets dans un tableau unique.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_title": "CompareWise",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
